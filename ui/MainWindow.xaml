<Window
    x:Class="ScreenTimeRS.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar. The default system title bar is hidden in code
             with ExtendsContentIntoTitleBar=true, so the app title is rendered
             exactly once and remains vertically aligned with the icon. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Image Width="16" Height="16"
                       Stretch="Uniform" VerticalAlignment="Center" Source="ms-appx:///Assets/ScreenTimeRS-titlebar.png"/>
                <TextBlock Text="ScreenTime RS" FontSize="14"
                           LineHeight="20" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="24,18,24,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AppHeaderTitle" Text="ScreenTime RS" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AppHeaderSubtitle" Text="Windows 使用时间与应用统计" Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ThemeButton" Click="ThemeButton_Click" Content="主题" Background="{ThemeResource ScreenTimeAccentBrush}" Foreground="White"/>
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" Content="刷新"/>
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="Nav" Grid.Row="2" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged" Loaded="Nav_Loaded" PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavOverview" Content="概览" Tag="overview" Icon="Home"/>
                <NavigationViewItem x:Name="NavApps" Content="应用使用时间" Tag="apps" Icon="AllApps"/>
                <NavigationViewItem x:Name="NavStats" Content="统计" Tag="stats" Icon="Library"/>
                <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings" Icon="Setting"/>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
