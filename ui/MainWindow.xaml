<Window
    x:Class="ScreenTimeRS.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact custom title bar with the application identity only. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10,0,140,0">
            <Grid x:Name="AppTitleBarDragRegion">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Width="16" Height="16"
                           Stretch="Uniform" VerticalAlignment="Center" Source="ms-appx:///Assets/ScreenTimeRS-titlebar.png"/>
                    <TextBlock Text="ScreenTime RS" FontSize="14"
                               LineHeight="20" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                            SelectionChanged="Nav_SelectionChanged" Loaded="Nav_Loaded" PaneDisplayMode="Left">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavOverview" Content="概览" Tag="overview" Icon="Home"/>
                    <NavigationViewItem x:Name="NavApps" Content="应用使用时间" Tag="apps" Icon="AllApps"/>
                    <NavigationViewItem x:Name="NavStats" Content="统计" Tag="stats" Icon="Library"/>
                    <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings" Icon="Setting"/>
                </NavigationView.MenuItems>
                <Frame x:Name="ContentFrame"/>
            </NavigationView>

            <!-- Invisible resize hit area on the navigation pane edge. The grip
                 appears only while the pointer is over the resize area or dragging. -->
            <Canvas x:Name="NavResizeCanvas" IsHitTestVisible="True">
                <Border x:Name="NavResizeHandle"
                        Width="10"
                        Height="72"
                        CornerRadius="5"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        PointerEntered="NavResizeHandle_PointerEntered"
                        PointerExited="NavResizeHandle_PointerExited"
                        PointerPressed="NavResizeHandle_PointerPressed"
                        PointerMoved="NavResizeHandle_PointerMoved"
                        PointerReleased="NavResizeHandle_PointerReleased"
                        PointerCanceled="NavResizeHandle_PointerCanceled"
                        PointerCaptureLost="NavResizeHandle_PointerCaptureLost">
                    <Border x:Name="NavResizeGrip"
                            Width="3"
                            Height="44"
                            CornerRadius="2"
                            Background="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Name="NavResizeToolTip" Content="拖动调整导航栏宽度"/>
                    </ToolTipService.ToolTip>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</Window>
